{
  "name": "unitygui-desktop",
  "productName": "UnityGUI",
  "version": "1.0.23",
  "description": "Generate full Unity, Roblox Studio, or instantly-playable Web (HTML5) games from a prompt — a one-click desktop app powered by free AI (Gemini / Groq / Ollama).",
  "main": "main.js",
  "author": "UnityGUI",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node test/test.js",
    "dist": "electron-builder --win --publish never",
    "dist:dir": "electron-builder --win --dir --publish never"
  },
  "devDependencies": {
    "electron": "^31.7.6",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.unitygui.app",
    "productName": "UnityGUI",
    "artifactName": "UnityGUI-Setup-${version}.${ext}",
    "files": ["main.js", "preload.js", "lib/**/*", "renderer/**/*", "assets/**/*"],
    "directories": { "output": "dist" },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
